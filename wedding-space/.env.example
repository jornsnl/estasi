# Postgres. Lokaal bijvoorbeeld postgresql://postgres@localhost:5432/wedding_space
# Op Supabase: knop Connect, "Session pooler" (poort 5432), met het databasewachtwoord.
DATABASE_URL=

# Optioneel: Supabase CA-certificaat om de databaseverbinding te controleren.
# DATABASE_CA_CERT=

# Publieke adres zonder / aan het eind; gebruikt in de links van de e-mails.
APP_URL=http://localhost:3001

# E-mail (SMTP). Zonder SMTP_HOST worden mails in de serverlog gezet en
# toont het beheer de uitnodigingslink zelf.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
MAIL_FROM="Sabine van Estasi Weddings <sabine@estasiweddings.nl>"

# Waar meldingen voor Sabine heen gaan (nieuwe vraag, enz.).
ADMIN_NOTIFY_EMAIL=sabine@estasiweddings.nl
