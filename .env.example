# "local" bewaart alles in .data/db.json (geen database nodig).
# "supabase" gebruikt Supabase (nog niet aangesloten, zie README).
DATA_BACKEND=local

# Geheim om sessiecookies te ondertekenen. Verplicht in productie.
SESSION_SECRET=verander-mij-naar-een-lange-willekeurige-string

# Publieke basis-URL, gebruikt voor activatielinks.
APP_URL=http://localhost:3000

# Contactadres voor cursisten (fase 1, zonder chat).
CONTACT_EMAIL=academy@estasiweddings.nl

# Later voor Supabase:
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
