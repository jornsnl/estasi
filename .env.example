# Alle gegevens (Academy en Your Wedding Space) staan in Postgres: DATABASE_URL hieronder is verplicht.
# Met SUPABASE_URL gebruikt de app Supabase Auth (inloggen, uitnodigen, herstel, tweestaps) en
# Supabase Storage (bucket academy). Zonder SUPABASE_URL (alleen lokaal, nooit in productie) werkt
# de ontwikkel-login met de demo-accounts uit `npm run db:seed` en staan uploads in Postgres.
# DATA_BACKEND is niet meer nodig; staat hij nog in de hosting, dan wordt hij genegeerd.

# Publieke basis-URL zonder / aan het eind. Gebruikt in de links van de e-mails.
APP_URL=http://localhost:3000

# Contactadres voor cursisten (fase 1, zonder chat).
CONTACT_EMAIL=academy@estasiweddings.nl

# Alleen voor de ontwikkel-login (zonder SUPABASE_URL): geheim voor de sessiecookie, minimaal 32 tekens.
SESSION_SECRET=verander-mij-naar-een-lange-willekeurige-string

# Productie (en wie lokaal tegen Supabase wil testen). Te vinden in Supabase onder Project Settings:
# Data API (URL) en API Keys. Beide sleutels worden alleen op de server gebruikt.
# SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...) of de oude "anon" key:
# SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) of de oude "service_role" key. Geheim houden:
# SUPABASE_SERVICE_ROLE_KEY=

# Verplicht. De database van de hele app: Academy (schema public) en Your Wedding Space
# (schema wedding_space), en de migraties (scripts/migrate.mjs, op Render het pre-deploy command).
# Lokaal een gewone Postgres, bijvoorbeeld postgres://postgres:postgres@localhost:5432/estasi
# Supabase, knop Connect, "Session pooler": postgresql://postgres.<ref>:<wachtwoord>@aws-...pooler.supabase.com:5432/postgres
# Speciale tekens in het wachtwoord URL-encoderen (bijvoorbeeld @ wordt %40).
# DATABASE_URL=
# Optioneel, om het certificaat te controleren: inhoud van de Supabase CA (Project Settings, Database, SSL).
# DATABASE_CA_CERT=

# Your Wedding Space: e-mail (uitnodigingen, vragen en antwoorden, RSVP-bevestigingen).
# Voorkeur: Resend (resend.com). Maak een API key aan (Sending access) en verifieer
# het domein estasiweddings.nl; MAIL_FROM moet een adres op dat domein zijn.
# RESEND_API_KEY=re_...
# Of in plaats daarvan een willekeurige SMTP-server:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=
# Zonder beide komen mails in de serverlog en toont het beheer de link zelf.
# MAIL_FROM="Sabine van Estasi Weddings <sabine@estasiweddings.nl>"
# ADMIN_NOTIFY_EMAIL=sabine@estasiweddings.nl

# Your Wedding Space: optioneel, AI-samenvattingen van opdrachten en het concept-stylingplan.
# ANTHROPIC_API_KEY=
